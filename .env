# Sinequa application name (config property "app", required for SSO provider
# detection via appInitializerFn and for queries). Login/password works without it.
# Set this to the app published on su-sba.demo.sinequa.com that you want to target.
VITE_SINEQUA_APP=mint_rnd

# OAuth provider to use, overriding the one auto-detected from the server pre-login.
# In proxy/dev mode the server auto-detects "identity" (redirect_uri -> demo server),
# but the round-trip only returns to the app via the dev provider whose redirect_uri
# points to https://localhost:4200. Leave empty to use the auto-detected provider.
VITE_SINEQUA_OAUTH_PROVIDER=identity-dev
